# ---------------- 数据库（Prisma Postgres / 任意 PostgreSQL） ----------------
DATABASE_URL="postgres://user:password@db.prisma.io:5432/postgres?sslmode=require"

# ---------------- 登录令牌签名密钥（生产环境务必替换） ----------------
NUXT_AUTH_SECRET="please-change-this-secret"

# ---------------- 站点地址（分享链接 / 海报二维码 / og:image 绝对地址） ----------------
# 线上部署时改成真实域名，例如 https://www.jiuwan-orchid.cn
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------- 七牛云对象存储 ----------------
NUXT_QINIU_ACCESS_KEY=""
NUXT_QINIU_SECRET_KEY=""
NUXT_QINIU_BUCKET=""
NUXT_QINIU_REGION="z0"
NUXT_QINIU_CDN_DOMAIN=""
NUXT_PUBLIC_QINIU_CDN_DOMAIN=""
