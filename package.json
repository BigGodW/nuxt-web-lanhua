    "nuxt": "3.21.11",
    "qiniu": "^7.15.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "vant": "4.10.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "prisma": "6.19.2",
    "tailwindcss": "3.4.19"
  }
}
