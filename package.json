{
  "name": "guolan-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "npx prisma generate && nuxt build",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
