// 九畹 · 国兰清赏 —— 数据模型
// 说明：所有内容型数据（品种/品类/文章/轮播）均带 status，前台只读取 published。
generator client {
  provider = "prisma-client-js"
  // EdgeOne 云函数（Node 20）运行在 RHEL + OpenSSL 1.1 环境，
  // 构建机是 OpenSSL 3.0，必须显式带上运行时的引擎，否则报
  // "could not locate the Query Engine for runtime rhel-openssl-1.1.x"
  //
  // 本地开发（Windows/macOS）：保留 "native"，否则客户端找不到本机引擎，
  //   报 "could not locate the Query Engine for runtime windows"。
  // 提交给 EdgeOne 构建时：可只留 ["rhel-openssl-1.1.x"]，产物小 21MB。
  // 切换后必须重跑 generate：停掉 nuxt dev → npx prisma generate → npm run dev
  // binaryTargets = ["native", "rhel-openssl-1.1.x"]
  // 部署到腾讯云配置
  // binaryTargets = [ "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 后台管理员
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nickname  String?
  avatar    String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// 兰花的品类：春兰 / 蕙兰 / 建兰 / 墨兰 / 寒兰 / 春剑 / 莲瓣兰
model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  subtitle    String?
  description String?
  cover       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orchids     Orchid[]

  @@map("categories")
}

/// 兰花品种
model Orchid {
  id         Int      @id @default(autoincrement())
  name       String
  alias      String?
  slug       String   @unique
  categoryId Int
  cover      String?
  images     String[]
  summary    String?
  content    String?
  origin     String?
  flowering  String?
  fragrance  String?
  difficulty String?
  light      String?
  tags       String[]
  viewCount  Int      @default(0)
  isFeatured Boolean  @default(false)
  status     String   @default("published")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@map("orchids")
}

/// 文章：兰文化 / 鉴赏 / 养护 / 动态
model Article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  cover       String?
  summary     String?
  content     String?
  category    String   @default("兰文化")
  author      String   @default("九畹编辑部")
  tags        String[]
  viewCount   Int      @default(0)
  isTop       Boolean  @default(false)
  status      String   @default("published")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("articles")
}

/// 首页轮播
model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  image     String?
  link      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

/// 站点配置（键值对，key 唯一）
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt

  @@map("settings")
}
